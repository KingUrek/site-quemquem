---
import Layout from "../layouts/Layout.astro";
import { vagas, local, disponibilidade, recebimento } from "../data/vagas";
const cfg = { vagas, local, disponibilidade, recebimento };
---

<Layout title="Trabalhe no Qüem Qüem · Vagas em Itaperuna" description="Vagas para garçom/garçonete, auxiliar de cozinha e churrasqueiro em Itaperuna. Não precisa ter experiência. Saiba como entregar seu currículo.">
  <div class="app">
    <header class="top">
      <a href="/" class="brand" aria-label="Qüem Qüem — voltar ao site">Q<span>ü</span>em Q<span>ü</span>em<small>restaurante · bar</small></a>
      <span class="tag">Vagas abertas</span>
    </header>
    <div class="progress" data-progress hidden>
      <p data-progress-text></p>
      <progress max="7" value="1" aria-label="Progresso da candidatura"></progress>
    </div>
    <main>
      <noscript><p class="notice">Ative o JavaScript para responder às perguntas. Você também pode levar seu currículo ao Qüem Qüem: {local.rua}, {local.cidade}. Recebemos de terça a domingo, das 8h às 15h.</p></noscript>

      <section data-step="inicio">
        <p class="eyebrow">Trabalhe com a gente</p>
        <h1>Seu próximo trabalho pode ser aqui.</h1>
        <p class="lead">Vagas no Qüem Qüem, em <strong>Itaperuna-RJ.</strong></p>
        <p class="badge">Não precisa ter experiência</p>
        <p class="intro">Escolha sua vaga para começar. Depois das perguntas, a próxima etapa é entregar seu currículo pessoalmente.</p>
        <div class="job-list">
          {vagas.map(v => (
            <button type="button" class="job" data-vaga={v.id}>
              <span><b>{v.nome}</b></span><span class="arrow" aria-hidden="true">→</span>
            </button>
          ))}
        </div>
        <div class="resume" data-resume hidden>
          <p>Já começou por aqui?</p>
          <button type="button" class="text-link" data-retomar>Continuar de onde parei</button>
          <button type="button" class="text-link" data-reiniciar>Apagar respostas e recomeçar</button>
        </div>
      </section>

      <section data-step="contato" hidden>
        <p class="eyebrow" data-fill="vaga"></p>
        <h2>Como você se chama?</h2>
        <form data-form="contato" novalidate>
          <label class="field" for="nome">Nome e sobrenome<input id="nome" name="nome" autocomplete="name" maxlength="120" required aria-describedby="erro-nome" /><span class="error" id="erro-nome" hidden></span></label>
          <label class="field" for="whatsapp">WhatsApp com DDD<input id="whatsapp" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="(22) 99999-9999" maxlength="15" required aria-describedby="erro-whatsapp" /><span class="error" id="erro-whatsapp" hidden></span></label>
          <p class="error" data-storage hidden role="status">Não foi possível salvar neste navegador. Você pode continuar, mas suas respostas podem se perder ao fechar a página.</p>
          <div class="actions"><button class="btn btn--gold" type="submit">Continuar</button><button class="text-link" type="button" data-back>Voltar</button></div>
        </form>
      </section>

      <section data-step="local" hidden>
        <p class="eyebrow" data-fill="vaga"></p>
        <h2>Vamos falar da localização.</h2>
        <p class="lead">O trabalho é presencial em Itaperuna.</p>
        <form data-form="local" novalidate>
          <fieldset aria-describedby="erro-mora">
            <legend>Você mora em Itaperuna?</legend>
            <div class="choices">
              <label class="choice"><input type="radio" name="mora" value="sim" required /><span>Sim</span></label>
              <label class="choice"><input type="radio" name="mora" value="nao" required /><span>Não</span></label>
            </div>
            <p class="error" id="erro-mora" hidden></p>
          </fieldset>
          <div data-outra-cidade hidden>
            <label class="field" for="cidade">Em qual cidade você mora?<input id="cidade" name="cidade" autocomplete="address-level2" maxlength="100" placeholder="Digite sua cidade" aria-describedby="erro-cidade" /><span class="error" id="erro-cidade" hidden></span></label>
          </div>
          <div class="actions"><button class="btn btn--gold" type="submit">Continuar</button><button class="text-link" type="button" data-back>Voltar</button></div>
        </form>
      </section>

      <section data-step="disponibilidade" hidden>
        <p class="eyebrow" data-fill="vaga"></p>
        <h2>Qual é a sua disponibilidade?</h2>
        <p class="lead">Essas respostas ajudam você a se preparar para conversar sobre a vaga.</p>
        <form data-form="disponibilidade" novalidate>
          {disponibilidade.map(q => (
            <fieldset aria-describedby={`erro-${q.id}`}>
              <legend>{q.pergunta}</legend>
              <div class="choices">
                {q.opcoes.map(o => <label class="choice"><input type="radio" name={q.id} value={o.v} required /><span>{o.l}</span></label>)}
              </div>
              <p class="error" id={`erro-${q.id}`} hidden></p>
            </fieldset>
          ))}
          <div class="actions"><button class="btn btn--gold" type="submit">Ver próximo passo</button><button class="text-link" type="button" data-back>Voltar</button></div>
        </form>
      </section>

      <section data-step="analise" class="loading" hidden aria-busy="true">
        <span class="spinner" aria-hidden="true"></span>
        <h2>Um instante…</h2>
        <p class="lead" data-loading-text role="status" aria-live="polite">Conferindo informações da vaga…</p>
      </section>

      <section data-step="resultado" hidden>
        <p class="eyebrow">Perguntas concluídas</p>
        <div data-result="seguir">
          <h2>Você pode dar o próximo passo, <span data-fill="nome"></span>.</h2>
          <p class="notice">O próximo passo é <strong>levar seu currículo impresso ao Qüem Qüem.</strong></p>
          <p class="help">Este aviso não é uma aprovação para a vaga. A entrevista será feita na hora, quando você entregar seu currículo.</p>
          <div class="actions"><button class="btn btn--gold" type="button" data-planejar>Escolher dia para levar o currículo</button><button class="text-link" type="button" data-back>Rever respostas</button></div>
        </div>
      </section>

      <section data-step="visita" hidden>
        <p class="eyebrow">Entrega do currículo</p>
        <h2>Qual dia funciona melhor para você?</h2>
        <p class="lead">Escolha quando pretende ir.</p>
        <p class="help">Recebemos currículos de terça a domingo, das 8h às 15h. A entrevista será feita na hora.</p>
        <form data-form="visita" novalidate>
          <fieldset><legend>Dia da visita</legend><div class="choices dates" data-datas></div></fieldset>
          <div class="date-picker" data-custom hidden><label class="field" for="data">Escolha outra data<input id="data" name="data" type="date" aria-describedby="erro-visita" /></label></div>
          <fieldset data-periodos-box hidden><legend>Em qual período você pretende ir?</legend><div class="choices" data-periodos></div></fieldset>
          <p class="help" data-sem-data hidden>Tudo bem. Você poderá voltar para escolher um dia quando souber sua disponibilidade.</p>
          <p class="error" id="erro-visita" role="alert" hidden></p>
          <div class="actions"><button class="btn btn--gold" type="submit" data-visita-cta>Salvar meu plano de visita</button><button class="text-link" type="button" data-back>Voltar</button></div>
        </form>
      </section>

      <section data-step="resumo" hidden>
        <p class="eyebrow">Seu próximo passo</p>
        <h2 data-fill="titulo-resumo">Leve seu currículo ao Qüem Qüem.</h2>
        <p class="lead" data-fill="texto-resumo"></p>
        <dl class="summary">
          <div><dt>Vaga</dt><dd data-fill="vaga"></dd></div>
          <div><dt>Dia</dt><dd data-fill="data"></dd></div>
          <div data-horario><dt>Horário</dt><dd data-fill="periodo"></dd></div>
          <div><dt>Levar</dt><dd>Currículo impresso com seu contato</dd></div>
        </dl>
        <address><strong>{local.nome}</strong><br />{local.rua}<br />{local.bairro} · {local.cidade}-{local.uf}</address>
        <p class="notice">Ao chegar, diga que veio <strong>entregar um currículo para a vaga de <span data-fill="vaga"></span></strong> e fazer a entrevista.</p>
        <div class="actions">
          <a class="btn btn--gold" href={local.maps} target="_blank" rel="noopener">Abrir localização</a>
          <button class="btn btn--line" type="button" data-lembrete>Salvar lembrete na agenda</button>
          <a class="text-link" data-google target="_blank" rel="noopener">Usar Google Agenda</a>
          <button class="text-link" type="button" data-mudar-dia>Escolher outro dia</button>
        </div>
        <p class="error" data-storage hidden role="status">Não foi possível salvar neste navegador. Anote o endereço e o dia escolhido antes de sair.</p>
      </section>
    </main>
    <footer>{local.nome} · {local.cidade}-{local.uf}<br /><a href="/">Conheça o restaurante</a></footer>
  </div>
  <script is:inline type="application/json" id="cfg-vagas" set:html={JSON.stringify(cfg).replace(/</g, "\\u003c")} />
  <script src="../scripts/vagas.ts"></script>
</Layout>

<style>
  .loading { text-align:center; padding-block:3rem; }
  .spinner { display:block; width:42px; height:42px; margin:0 auto 1.5rem; border:3px solid var(--dark-line); border-top-color:var(--champagne); border-radius:50%; animation:spin .8s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }
  @media(prefers-reduced-motion:reduce) { .spinner { animation:none; } }
  .app { min-height:100svh; display:flex; flex-direction:column; background:var(--dark-bg); }
  .app [hidden] { display:none !important; }
  .top { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:1rem var(--gutter); border-bottom:1px solid var(--dark-line); }
  .brand { font-family:var(--display); font-size:1.45rem; line-height:1.15; }
  .brand span { color:var(--champagne); }
  .brand small { display:block; font-family:var(--body); font-size:.6rem; letter-spacing:.2em; text-transform:uppercase; color:var(--dark-dim); margin-top:.25rem; }
  .tag { font-size:.72rem; background:var(--champagne); color:var(--preto); padding:.3rem .65rem; white-space:nowrap; }
  main { width:min(100%,660px); padding:1.8rem 1.5rem 3rem; margin-inline:auto; flex:1; }
  h1,h2 { font-size:clamp(1.8rem,1.3rem + 2vw,2.55rem); line-height:1.16; letter-spacing:-.015em; text-wrap:balance; }
  .eyebrow { color:var(--champagne); font-size:.9rem; margin-bottom:.65rem; }
  .lead { font-size:1.05rem; color:var(--dark-dim); margin-top:1rem; }
  .badge { display:inline-block; margin-top:.85rem; padding:.25rem .65rem; background:rgba(201,165,106,.13); color:var(--ouro); font-weight:600; font-size:.9rem; }
  .intro { margin-top:.85rem; color:var(--dark-dim); font-size:.95rem; }
  .job-list { display:grid; gap:.65rem; margin-top:1.2rem; }
  .job { display:flex; align-items:center; justify-content:space-between; gap:1rem; text-align:left; border:1px solid var(--dark-line); background:rgba(244,239,232,.04); padding:1rem 1.1rem; color:var(--marfim); cursor:pointer; font-family:var(--body); width:100%; }
  .job b { display:block; font-family:var(--display); font-size:1.3rem; font-weight:480; }
  .arrow { font-size:1.5rem; color:var(--champagne); }
  .job:hover { border-color:var(--champagne); background:rgba(201,165,106,.1); }
  .resume { margin-top:1.5rem; display:grid; gap:.4rem; border-top:1px solid var(--dark-line); padding-top:1rem; font-size:.9rem; }
  .progress { width:min(100%,660px); padding:1.2rem 1.5rem 0; margin-inline:auto; }
  .progress p { font-size:.8rem; color:var(--dark-dim); margin-bottom:.4rem; }
  progress { width:100%; height:4px; border:0; display:block; background:var(--dark-line); color:var(--champagne); }
  progress::-webkit-progress-bar { background:var(--dark-line); } progress::-webkit-progress-value { background:var(--champagne); } progress::-moz-progress-bar { background:var(--champagne); }
  .field { display:grid; gap:.45rem; margin-top:1.3rem; font-size:1rem; }
  input:not([type=radio]) { width:100%; min-width:0; min-height:50px; font:inherit; padding:.8rem; color:var(--marfim); background:var(--cafe); border:1px solid var(--dark-line); border-radius:2px; color-scheme:dark; }
  input::placeholder { color:var(--dark-dim); }
  input[aria-invalid=true] { border-color:#e39a9a; }
  fieldset { border:0; margin:1.5rem 0 0; padding:0; min-width:0; }
  legend { font-size:1rem; font-weight:600; margin-bottom:.65rem; padding:0; }
  .choices { display:grid; grid-template-columns:1fr 1fr; gap:.6rem; }
  .choices :global(.choice) { position:relative; display:flex; gap:.65rem; align-items:center; padding:.8rem; border:1px solid var(--dark-line); background:rgba(244,239,232,.03); min-height:52px; cursor:pointer; font-size:1rem; line-height:1.4; }
  .choices :global(.choice:has(input:checked)) { border-color:var(--champagne); background:rgba(201,165,106,.15); }
  .choices :global(input[type=radio]) { width:18px; height:18px; flex-shrink:0; accent-color:var(--champagne); }
  .dates { grid-template-columns:1fr; }
  .choices :global(small) { display:block; color:var(--dark-dim); font-size:.85rem; }
  .help { color:var(--dark-dim); font-size:.9rem; line-height:1.55; margin-top:1rem; }
  .error { color:#f0aaa4; font-size:.9rem; margin-top:.35rem; }
  .actions { display:grid; gap:.7rem; margin-top:1.6rem; }
  .btn { width:100%; justify-content:center; text-align:center; min-height:52px; padding:.95rem 1rem; font-size:.95rem; letter-spacing:.02em; text-transform:none; }
  .text-link { font-family:inherit; font-size:.9rem; background:none; border:none; color:var(--ouro); padding:.6rem .2rem; min-height:44px; text-decoration:underline; text-underline-offset:4px; cursor:pointer; text-align:center; }
  :is(button,a,input):focus-visible { outline:2px solid var(--ouro); outline-offset:4px; }
  h1:focus,h2:focus { outline:none; }
  .notice { margin-top:1.25rem; border-left:3px solid var(--champagne); padding:1rem; background:rgba(201,165,106,.08); color:var(--dark-dim); }
  .notice strong { color:var(--marfim); }
  .summary { margin-top:1.4rem; border:1px solid var(--dark-line); }
  .summary > div { padding:.8rem 1rem; display:grid; grid-template-columns:5rem 1fr; gap:1rem; }
  .summary > div + div { border-top:1px solid var(--dark-line); }
  dt { color:var(--champagne); font-size:.85rem; } dd { font-size:1rem; overflow-wrap:anywhere; }
  address { margin-top:1.3rem; font-style:normal; color:var(--dark-dim); font-size:1rem; }
  footer { padding:1rem 1.5rem; border-top:1px solid var(--dark-line); text-align:center; color:var(--dark-dim); font-size:.85rem; }
  footer a { display:inline-block; padding:.5rem; text-decoration:underline; }
  @media(max-width:380px) { main { padding-inline:1.1rem; } .choices { grid-template-columns:1fr; } .summary > div { grid-template-columns:1fr; gap:.2rem; } }
</style>
